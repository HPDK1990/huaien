+def _has_raw_voice_audio(item_list: list[dict[str, Any]]) -> bool:
+    """这条消息里有没有**可下载的原始语音**。
+
+    微信把一条语音同时放成两个 item:
+      - ``text_item``   = 腾讯云 ASR 的文字 (质量差, 中文常被转成英文乱码)
+      - ``voice_item``  = 原始音频 (带 media 块, 可下载)
+
+    只要原始音频在, 就**必须走本地 STT** —— 腾讯那份 ASR 不能信。
+    """
+    for item in item_list:
+        if item.get("type") == ITEM_VOICE:
+            voice_item = item.get("voice_item") or {}
+            if (voice_item.get("media") or {}) and (
+                voice_item.get("media", {}).get("encrypt_query_param")
+                or voice_item.get("media", {}).get("full_url")
+            ):
+                return True
+    return False
+
+
